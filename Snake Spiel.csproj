<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Snake_Spiel</RootNamespace>
    <AssemblyName>Snake</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>snake.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Der Teststand in Tests\ ist ein eigenes Projekt und gehört nicht in die EXE -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!-- Logos oben links (Snake, mit Krone nach dem Durchspielen) und oben rechts (AL),
       als Ressource in die EXE eingebettet -->
  <ItemGroup>
    <Resource Include="Assets\snake-logo.png" />
    <Resource Include="Assets\snake-logo-krone.png" />
    <Resource Include="Assets\al-logo.png" />
  </ItemGroup>

  <!-- Angaben, die Windows im Dateidialog und in den Eigenschaften der EXE anzeigt -->
  <PropertyGroup>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <Product>Snake</Product>
    <Authors>Alexander Last</Authors>
    <Company>Alexander Last</Company>
    <Description>Snake mit drei Schwierigkeitsgraden, vier Eskalationsstufen bis hin zu Verflucht, einem Ende bei Level 25, lokalem Rekord, gesprochenem Vorspann und Musik, die das Programm selbst berechnet.</Description>
    <Copyright>Copyright (c) 2026 Alexander Last</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

</Project>
