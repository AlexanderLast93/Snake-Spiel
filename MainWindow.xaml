<Window x:Class="Snake_Spiel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snake_Spiel"
        mc:Ignorable="d"
        Title="Snake"
        Width="884"
        Height="862"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{StaticResource BackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">

    <Border BorderBrush="#FF17304A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Eigene Titelleiste, damit das Fenster durchgehend dunkel bleibt -->
            <Grid Grid.Row="0"
                  Background="#FF080D16"
                  Height="38"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="{StaticResource AccentColor}"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.9" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="SNAKE"
                               Margin="10,0,0,0"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock x:Name="VersionText"
                               Text="WPF Edition"
                               Margin="10,0,0,0"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#x2013;"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Minimieren"
                            Click="MinimizeButton_Click" />
                    <Button Content="&#x2715;"
                            Style="{StaticResource CaptionButtonStyle}"
                            ToolTip="Schließen"
                            Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Anzeigeleiste -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,18,0,16">
                <Border Style="{StaticResource HudCardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="PUNKTE" Style="{StaticResource HudLabelStyle}" />
                        <TextBlock x:Name="ScoreText"
                                   Text="0"
                                   Style="{StaticResource HudValueStyle}"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HudCardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="REKORD" Style="{StaticResource HudLabelStyle}" />
                        <TextBlock x:Name="HighScoreText" Text="0" Style="{StaticResource HudValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HudCardStyle}" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="LEVEL" Style="{StaticResource HudLabelStyle}" />
                        <TextBlock x:Name="LevelText" Text="1" Style="{StaticResource HudValueStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HudCardStyle}" Margin="6,0" MinWidth="132">
                    <StackPanel>
                        <TextBlock Text="MODUS" Style="{StaticResource HudLabelStyle}" />
                        <TextBlock x:Name="ModeText"
                                   Text="NORMAL"
                                   Style="{StaticResource HudValueStyle}"
                                   FontSize="20"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Spielfeld -->
            <Border Grid.Row="2"
                    x:Name="BoardFrame"
                    Width="802"
                    Height="642"
                    CornerRadius="12"
                    Background="#FF060B13"
                    BorderBrush="#FF1B4258"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource AccentColor}"
                                      BlurRadius="34"
                                      ShadowDepth="0"
                                      Opacity="0.32" />
                </Border.Effect>

                <Grid ClipToBounds="True">
                    <Canvas x:Name="GridCanvas" Width="800" Height="640" />

                    <Canvas x:Name="FoodCanvas" Width="800" Height="640">
                        <Canvas.Effect>
                            <DropShadowEffect Color="{StaticResource FoodColor}"
                                              BlurRadius="22"
                                              ShadowDepth="0"
                                              Opacity="0.95" />
                        </Canvas.Effect>
                    </Canvas>

                    <Canvas x:Name="SnakeCanvas" Width="800" Height="640">
                        <Canvas.Effect>
                            <DropShadowEffect x:Name="SnakeGlow"
                                              Color="{StaticResource AccentColor}"
                                              BlurRadius="18"
                                              ShadowDepth="0"
                                              Opacity="0.8" />
                        </Canvas.Effect>
                    </Canvas>

                    <!-- Overlay für Menü, Pause und Spielende -->
                    <Grid x:Name="Overlay" Background="#EE050A12">

                        <StackPanel x:Name="MenuPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="SNAKE" Style="{StaticResource OverlayTitleStyle}" />
                            <TextBlock Text="Pfeiltasten steuern · die Wände sind offen"
                                       Style="{StaticResource OverlayHintStyle}"
                                       FontSize="14"
                                       Margin="0,6,0,30" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="EasyButton"
                                        Style="{StaticResource NeonButtonStyle}"
                                        Margin="8,0"
                                        Tag="easy"
                                        Click="DifficultyButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="1 · LEICHT"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="gemütlich"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NormalButton"
                                        Style="{StaticResource NeonButtonStyle}"
                                        Margin="8,0"
                                        Tag="normal"
                                        Click="DifficultyButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="2 · NORMAL"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="klassisch"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="HardButton"
                                        Style="{StaticResource NeonButtonStyle}"
                                        Margin="8,0"
                                        Tag="hard"
                                        Click="DifficultyButton_Click">
                                    <StackPanel>
                                        <TextBlock Text="3 · SCHNELL"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="für schnelle Finger"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock x:Name="MenuRecordsText"
                                       Style="{StaticResource OverlayHintStyle}"
                                       Margin="0,30,0,0"
                                       Text="Rekorde: –" />
                            <TextBlock Text="Enter startet den zuletzt gewählten Modus"
                                       Style="{StaticResource OverlayHintStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="PausePanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="PAUSE" Style="{StaticResource OverlayTitleStyle}" FontSize="48" />
                            <TextBlock Text="Leertaste = weiterspielen · Esc = zurück ins Menü"
                                       Style="{StaticResource OverlayHintStyle}"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <StackPanel x:Name="GameOverPanel"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="GAME OVER"
                                       Style="{StaticResource OverlayTitleStyle}"
                                       FontSize="50"
                                       Foreground="{StaticResource DangerBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource DangerColor}"
                                                      BlurRadius="32"
                                                      ShadowDepth="0"
                                                      Opacity="0.75" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock x:Name="GameOverScoreText"
                                       Text="0 Punkte"
                                       FontFamily="Consolas"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0" />

                            <TextBlock x:Name="NewRecordText"
                                       Text="NEUER REKORD"
                                       FontFamily="Segoe UI"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"
                                       Visibility="Collapsed">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentColor}"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0.85" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <TextBlock x:Name="GameOverDetailText"
                                       Style="{StaticResource OverlayHintStyle}"
                                       Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,26,0,0">
                                <Button Content="Nochmal (Enter)"
                                        Style="{StaticResource NeonButtonStyle}"
                                        Margin="8,0"
                                        Click="RestartButton_Click" />
                                <Button Content="Menü (Esc)"
                                        Style="{StaticResource NeonButtonStyle}"
                                        Margin="8,0"
                                        Click="MenuButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Fußzeile mit Tastenbelegung -->
            <Grid Grid.Row="3" Margin="42,14,42,16">
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="Pfeiltasten / WASD = lenken     Leertaste = Pause     R = Neustart     Esc = Menü" />
                <TextBlock x:Name="SoundStatusText"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Text="M = Ton aus" />
            </Grid>
        </Grid>
    </Border>
</Window>
